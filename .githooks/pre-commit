#!/bin/bash

# Pre-commit hook to validate PHP files for required method calls
#
# Checks:
# 1. Classes implementing ISorcererAbility must call createSorcererAbilityStartEvent
# 2. Classes implementing ISorcererAbility must call createSorcererAbilityPlayedEvent
# 3. Classes extending action base classes must call createActionResolvedEvent
# 4. Classes extending CardReaction or AttachmentReaction must call $this->setUsed()
# 5. Classes calling createAttachmentEquippedEvent must call getRequiredAttachTargetId
# 6. Classes must not implement both IAbilityThatTargetsCharacters and IAbilityThatTargetsCards
# 7. Classes implementing IRangedAbility must call createRangedAbilityPlayedEvent
# 8. Classes extending Maneuver must handle EventManeuverCanceled
# 9. Classes extending Technique must handle EventTechniqueCanceled

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

errors_found=0

# Get list of staged PHP files
staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')

if [ -z "$staged_files" ]; then
    exit 0
fi

for file in $staged_files; do
    # Skip if file doesn't exist (might have been deleted)
    if [ ! -f "$file" ]; then
        continue
    fi

    content=$(cat "$file")

    # Check if the class implements ISorcererAbility
    if echo "$content" | grep -qE 'class\s+\w+.*implements.*ISorcererAbility'; then
        
        # Check for createSorcererAbilityStartEvent
        if ! echo "$content" | grep -q 'createSorcererAbilityStartEvent'; then
            echo -e "${RED}ERROR:${NC} $file"
            echo -e "  Class implements ISorcererAbility but does not call ${YELLOW}createSorcererAbilityStartEvent()${NC}"
            errors_found=1
        fi
        
        # Check for createSorcererAbilityPlayedEvent
        if ! echo "$content" | grep -q 'createSorcererAbilityPlayedEvent'; then
            echo -e "${RED}ERROR:${NC} $file"
            echo -e "  Class implements ISorcererAbility but does not call ${YELLOW}createSorcererAbilityPlayedEvent()${NC}"
            errors_found=1
        fi
    fi

    # Check if the class implements both IAbilityThatTargetsCharacters and IAbilityThatTargetsCards
    if echo "$content" | grep -qE 'class\s+\w+.*implements.*IAbilityThatTargetsCharacters' && \
       echo "$content" | grep -qE 'class\s+\w+.*implements.*IAbilityThatTargetsCards'; then
        echo -e "${RED}ERROR:${NC} $file"
        echo -e "  Class implements both ${YELLOW}IAbilityThatTargetsCharacters${NC} and ${YELLOW}IAbilityThatTargetsCards${NC}"
        echo -e "  A class should only implement one of these interfaces."
        errors_found=1
    fi

    # Check if the class implements IRangedAbility
    if echo "$content" | grep -qE 'class\s+\w+.*implements.*IRangedAbility'; then
        
        # Check for createRangedAbilityPlayedEvent
        if ! echo "$content" | grep -q 'createRangedAbilityPlayedEvent'; then
            echo -e "${RED}ERROR:${NC} $file"
            echo -e "  Class implements IRangedAbility but does not call ${YELLOW}createRangedAbilityPlayedEvent()${NC}"
            errors_found=1
        fi
    fi

    # Check if the class extends Action
    if echo "$content" | grep -qE 'class\s+\w+\s+extends\s+(CardAction|RiskAction|RiskCityAction)'; then
        
        # Check for createActionResolvedEvent
        if ! echo "$content" | grep -q 'createActionResolvedEvent'; then
            echo -e "${RED}ERROR:${NC} $file"
            echo -e "  Class extends Action but does not call ${YELLOW}createActionResolvedEvent()${NC}"
            errors_found=1
        fi
    fi

    # Check if the class extends CardReaction or AttachmentReaction
    if echo "$content" | grep -qE 'class\s+\w+\s+extends\s+(CardReaction|AttachmentReaction)'; then
        
        # Check for $this->setUsed()
        if ! echo "$content" | grep -q '\$this->setUsed('; then
            echo -e "${RED}ERROR:${NC} $file"
            echo -e "  Class extends CardReaction/AttachmentReaction but does not call ${YELLOW}\$this->setUsed()${NC}"
            errors_found=1
        fi

        # Check for $this->isAvailable()
        if ! echo "$content" | grep -q '\$this->isAvailable('; then
            echo -e "${RED}ERROR:${NC} $file"
            echo -e "  Class extends CardReaction/AttachmentReaction but does not call ${YELLOW}\$this->isAvailable()${NC}"
            errors_found=1
        fi
    fi

    # Check if the class calls createAttachmentEquippedEvent (skip EventFactory.php)
    if echo "$content" | grep -q 'createAttachmentEquippedEvent' && [[ "$file" != *"EventFactory.php" ]]; then

        # Check for getRequiredAttachTargetId
        if ! echo "$content" | grep -q 'getRequiredAttachTargetId'; then
            echo -e "${RED}ERROR:${NC} $file"
            echo -e "  Class calls ${YELLOW}createAttachmentEquippedEvent()${NC} but does not call ${YELLOW}getRequiredAttachTargetId()${NC}"
            echo -e "  Some attachments may need to attach to a different target than the performer."
            errors_found=1
        fi
    fi

    # Check if the class extends Maneuver
    if echo "$content" | grep -qE 'class\s+\w+\s+extends\s+Maneuver'; then
        
        if ! echo "$content" | grep -q 'instanceof EventManeuverCanceled && \$event->maneuverId == \$this->Id' && \
           ! echo "$content" | grep -q 'EventManeuverCanceled handler not needed'; then
            echo -e "${RED}ERROR:${NC} $file"
            echo -e "  Class extends Maneuver but does not handle ${YELLOW}EventManeuverCanceled${NC}"
            echo -e "  Add: if (\$event instanceof EventManeuverCanceled && \$event->maneuverId == \$this->Id)"
            echo -e "  Or add a comment: // EventManeuverCanceled handler not needed"
            errors_found=1
        fi
    fi

    # Check if the class extends Technique
    if echo "$content" | grep -qE 'class\s+\w+\s+extends\s+Technique'; then
        
        if ! echo "$content" | grep -q 'instanceof EventTechniqueCanceled && \$event->techniqueId == \$this->Id' && \
           ! echo "$content" | grep -q 'EventTechniqueCanceled handler not needed'; then
            echo -e "${RED}ERROR:${NC} $file"
            echo -e "  Class extends Technique but does not handle ${YELLOW}EventTechniqueCanceled${NC}"
            echo -e "  Add: if (\$event instanceof EventTechniqueCanceled && \$event->techniqueId == \$this->Id)"
            echo -e "  Or add a comment: // EventTechniqueCanceled handler not needed"
            errors_found=1
        fi
    fi

    # Check if the class extends RiskReaction or CancelReaction
    if echo "$content" | grep -qE 'class\s+\w+\s+extends\s+(RiskReaction|CancelReaction)'; then
        
        # Make sure the reaction is only available in the hand
        if ! echo "$content" | grep -q 'Location == Game::LOCATION_HAND'; then
            echo -e "${RED}ERROR:${NC} $file"
            echo -e "  Class extends RiskReaction/CancelReaction but does not check if the reaction is only available in the hand"
            errors_found=1
        fi
    fi
done

if [ $errors_found -eq 1 ]; then
    echo ""
    echo -e "${RED}Commit aborted.${NC} Please fix the errors above before committing."
    exit 1
fi

echo -e "${GREEN}Pre-commit checks passed.${NC}"
exit 0
